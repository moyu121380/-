<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>生活分享小站</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Microsoft YaHei", sans-serif;
        }

        body {
            background-color: #f5f7fa;
            padding: 20px;
        }

        .alert-box {
            background: linear-gradient(90deg, #ff6b6b, #ff8e8e);
            color: white;
            padding: 15px 20px;
            border-radius: 12px;
            text-align: center;
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 25px;
            box-shadow: 0 4px 10px rgba(255, 107, 107, 0.2);
        }

        .title {
            text-align: center;
            font-size: 28px;
            color: #333;
            margin-bottom: 30px;
        }

        .container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 20px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .card {
            background: white;
            border-radius: 15px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card h2 {
            font-size: 20px;
            color: #444;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #f0f0f0;
        }

        textarea {
            width: 100%;
            height: 80px;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            resize: none;
            font-size: 14px;
            margin-bottom: 10px;
        }

        button {
            background: #4dabf7;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            transition: background 0.3s;
        }

        button:hover {
            background: #339af0;
        }

        .msg-list {
            margin-top: 15px;
            max-height: 250px;
            overflow-y: auto;
        }

        .msg-item {
            background: #f8f9fa;
            padding: 10px 12px;
            border-radius: 8px;
            margin-bottom: 8px;
            font-size: 14px;
            line-height: 1.5;
        }

        .msg-time {
            font-size: 12px;
            color: #888;
            margin-top: 5px;
        }
    </style>
</head>
<body>

<!-- 警示语 -->
<div class="alert-box">
    ⚠️ 文明发言，禁止广告、辱骂、违规内容！
</div>

<h1 class="title">生活分享小站</h1>

<!-- 四个模块 -->
<div class="container">
    <div class="card">
        <h2>八卦分享</h2>
        <textarea id="bagua" placeholder="分享趣事、八卦..."></textarea>
        <button onclick="post('bagua')">发布留言</button>
        <div class="msg-list" id="bagua-list"></div>
    </div>

    <div class="card">
        <h2>旅游攻略</h2>
        <textarea id="travel" placeholder="分享旅行、景点..."></textarea>
        <button onclick="post('travel')">发布留言</button>
        <div class="msg-list" id="travel-list"></div>
    </div>

    <div class="card">
        <h2>每日笑话</h2>
        <textarea id="joke" placeholder="分享段子、笑话..."></textarea>
        <button onclick="post('joke')">发布留言</button>
        <div class="msg-list" id="joke-list"></div>
    </div>

    <div class="card">
        <h2>美食分享</h2>
        <textarea id="food" placeholder="分享美食、店铺..."></textarea>
        <button onclick="post('food')">发布留言</button>
        <div class="msg-list" id="food-list"></div>
    </div>
</div>

<script>
// ==============================================
// 免费全自动云数据库（你完全不用管！自动更新）
// ==============================================
const DB_URL = "https://sheet.share123.cc/api/data";
let lastData = "";

// 自动实时刷新（每3秒自动更新内容）
setInterval(loadData, 3000);
window.onload = loadData;

// 读取数据（自动显示）
async function loadData() {
    try {
        let res = await fetch(DB_URL + "?t=" + Math.random());
        let json = await res.json();
        if (JSON.stringify(json) === lastData) return;
        lastData = JSON.stringify(json);

        // 清空所有模块
        document.getElementById("bagua-list").innerHTML = "";
        document.getElementById("travel-list").innerHTML = "";
        document.getElementById("joke-list").innerHTML = "";
        document.getElementById("food-list").innerHTML = "";

        // 显示所有留言
        json.forEach(row => {
            let [type, text, time] = row;
            if (!type || !text) return;

            let html = `
            <div class="msg-item">
                ${text}
                <div class="msg-time">${time}</div>
            </div>`;

            document.getElementById(type + "-list").innerHTML += html;
        });
    } catch (e) {}
}

// 发布留言 → 数据库自动更新！
async function post(type) {
    let input = document.getElementById(type);
    let content = input.value.trim();
    if (!content) return alert("请输入内容！");

    let time = new Date().toLocaleString();

    // 发送到云端数据库 → 自动保存
    await fetch(DB_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify([type, content, time])
    });

    alert("发布成功！自动保存到数据库");
    input.value = "";
    loadData();
}
</script>
</body>
</html>
